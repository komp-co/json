import core.assert.assert_eq

fun sample(writer: JsonWriter): String {
    var w = writer
    w.begin_object()
    w.field_string("name", "komp")
    w.key("tags")
    w.begin_array()
    w.write_string("compiler")
    w.write_int64(2)
    w.end_array()
    w.key("empty")
    w.begin_object()
    w.end_object()
    w.end_object()
    return w.finish()
}

@test
fun compact_output_has_no_whitespace(): void {
    assert_eq(sample(JsonWriter.new()).as_str(), "{\"name\":\"komp\",\"tags\":[\"compiler\",2],\"empty\":{}}",
        "one line, no spaces")
}

@test
fun pretty_output_indents_each_level(): void {
    val expected = """{
  "name": "komp",
  "tags": [
    "compiler",
    2
  ],
  "empty": {}
}"""
    assert_eq(sample(JsonWriter.pretty(2)).as_str(), expected, "a member per line, two spaces per level")
}

@test
fun a_writer_is_complete_when_every_container_is_closed(): void {
    var w = JsonWriter.new()
    w.begin_array()
    w.end_array()
    assert_eq(w.is_complete(), true, "[]")
}

@test
fun an_open_container_is_not_complete(): void {
    var w = JsonWriter.new()
    w.begin_object()
    assert_eq(w.is_complete(), false, "still open")
}

@test
fun a_top_level_value_is_a_document(): void {
    var w = JsonWriter.new()
    w.write_string("alone")
    assert_eq(w.finish().as_str(), "\"alone\"", "any value can be the whole document")
}

@test
fun scalar_fields_are_written(): void {
    var w = JsonWriter.new()
    w.begin_object()
    w.field_int64("i", -3)
    w.field_uint64("u", 7)
    w.field_bool("b", false)
    w.field_null("n")
    w.end_object()
    assert_eq(w.finish().as_str(), "{\"i\":-3,\"u\":7,\"b\":false,\"n\":null}", "each field once, in order")
}

@test
fun a_float_is_written_to_round_trip(): void {
    var w = JsonWriter.new()
    w.write_float64(0.1)
    assert_eq(w.finish().as_str(), "0.1", "the shortest text that reads back as the same float")
}

@test
fun a_non_finite_float_is_written_as_null(): void {
    var w = JsonWriter.new()
    w.write_float64(1.0 / 0.0)
    assert_eq(w.finish().as_str(), "null", "JSON has no infinity")
}

@test
fun raw_json_is_spliced_in(): void {
    var w = JsonWriter.new()
    w.begin_array()
    w.write_raw("{\"x\":1}")
    w.write_int64(2)
    w.end_array()
    assert_eq(w.finish().as_str(), "[{\"x\":1},2]", "as one value")
}

@test
fun keys_are_escaped(): void {
    var w = JsonWriter.new()
    w.begin_object()
    w.field_bool("a\"b", true)
    w.end_object()
    assert_eq(w.finish().as_str(), "{\"a\\\"b\":true}", "a key is a JSON string")
}

@test
fun written_json_reads_back(): void {
    var w = JsonWriter.pretty(4)
    w.begin_object()
    w.field_string("text", "tab\there, é")
    w.end_object()
    val text = w.finish()
    var reader = JsonReader.new(text.as_str())
    val _start = reader.begin_object()
    val _more = reader.object_has_next()
    val _key = reader.read_key()
    assert_eq(reader.read_string().as_str(), "tab\there, é", "writer and reader agree")
}

@test
fun an_object_writer_starts_inside_its_object(): void {
    var w = JsonWriter.object()
    w.field_uint32("line", 12)
    assert_eq(w.finish().as_str(), "{\"line\":12}", "finish closes it")
}

@test
fun an_array_writer_starts_inside_its_array(): void {
    var w = JsonWriter.array()
    w.write_string("a")
    assert_eq(w.finish().as_str(), "[\"a\"]", "finish closes it")
}

@test
fun finish_closes_every_open_container(): void {
    var w = JsonWriter.pretty(2)
    w.begin_object()
    w.key("list")
    w.begin_array()
    w.write_null()
    val expected = """{
  "list": [
    null
  ]
}"""
    assert_eq(w.finish().as_str(), expected, "innermost first, each on its own line")
}

@test
fun finish_leaves_the_writer_open(): void {
    var w = JsonWriter.array()
    val _first = w.finish()
    w.write_bool(true)
    assert_eq(w.finish().as_str(), "[true]", "writing can go on after a look")
}
