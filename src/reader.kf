// Reading one JSON document in order: the caller walks objects and arrays and
// reads each value as the type it expects.
//
//   var r = JsonReader.new(text)
//   if r.begin_object() {
//       while r.object_has_next() {
//           val key = r.read_key()
//           if key.as_str() == "name" { name = r.read_string() } else { r.skip_value() }
//       }
//   }
//   if r.has_error() { report(r.error_offset()) }

extern "C" fun kf_json_parse_float64(text: str): float64

/// What the next value is, as `peek_kind` sees its first byte.
@derive(Copy, Equal)
pub enum JsonKind {
    Object
    Array
    String
    Number
    Bool
    Null
    /// Only whitespace is left.
    End
    /// The next byte starts no JSON value.
    Invalid
}

/// A failed read returns a default and sets the error; every read after the
/// first error fails too.
pub struct JsonReader {
    var source: String
    var position: uint64
    var failed: bool
    var failed_at: uint64
}

impl JsonReader {
    pub static fun new(source: str): JsonReader {
        return JsonReader { source: String.from(source), position: 0, failed: false, failed_at: 0 }
    }

    pub fun has_error(): bool {
        return self.failed
    }

    /// The byte offset of the first error; 0 when there is none.
    pub fun error_offset(): uint64 {
        return self.failed_at
    }

    pub mutating fun peek_kind(): JsonKind {
        self.skip_space()
        if self.position >= self.source.byte_len() { return JsonKind.End }
        val byte = self.peek()
        if byte == 123 { return JsonKind.Object }
        if byte == 91 { return JsonKind.Array }
        if byte == 34 { return JsonKind.String }
        if byte == 116 || byte == 102 { return JsonKind.Bool }
        if byte == 110 { return JsonKind.Null }
        if byte == 45 || (byte >= 48 && byte <= 57) { return JsonKind.Number }
        return JsonKind.Invalid
    }

    /// Only whitespace is left: the document is fully read.
    pub mutating fun at_end(): bool {
        self.skip_space()
        return self.position >= self.source.byte_len()
    }

    pub mutating fun begin_object(): bool {
        return self.consume_byte(123)
    }

    pub mutating fun object_has_next(): bool {
        return self.container_has_next(125)
    }

    pub mutating fun begin_array(): bool {
        return self.consume_byte(91)
    }

    pub mutating fun array_has_next(): bool {
        return self.container_has_next(93)
    }

    pub mutating fun read_key(): String {
        val key = self.read_string()
        if !self.consume_byte(58) { self.fail() }
        return key
    }

    pub mutating fun read_string(): String {
        self.skip_space()
        if self.peek() != 34 {
            self.fail()
            return ""
        }
        self.position = self.position + 1
        var out = ""
        var start = self.position
        while self.position < self.source.byte_len() {
            val byte = self.peek()
            if byte == 34 {
                self.append_slice(&var out, start, self.position)
                self.position = self.position + 1
                return out
            }
            if byte < 32 {
                self.fail()
                return out
            }
            if byte == 92 {
                self.append_slice(&var out, start, self.position)
                self.position = self.position + 1
                self.append_escape(&var out)
                if self.failed { return out }
                start = self.position
            } else {
                self.position = self.position + 1
            }
        }
        self.fail()
        return out
    }

    /// An integer from -2^63 to 2^63 - 1; a fraction, an exponent or anything
    /// out of range is an error.
    pub mutating fun read_int64(): int64 {
        val text = self.number_text()
        if self.failed { return 0 }
        val largest: uint64 = 9223372036854775807
        val negative = text.as_str().starts_with("-")
        val limit = if negative { largest + 1 } else { largest }
        val from: uint64 = if negative { 1 } else { 0 }
        val magnitude = integer_value(text.as_str(), from, limit) ?: return self.failed_with(0)
        if !negative { return magnitude as int64 }
        if magnitude > largest { return (0 - (largest as int64)) - 1 }
        return 0 - (magnitude as int64)
    }

    /// An integer from 0 to 2^64 - 1.
    pub mutating fun read_uint64(): uint64 {
        val text = self.number_text()
        if self.failed { return 0 }
        val none: uint64 = 0
        val value = integer_value(text.as_str(), 0, none - 1) ?: return self.failed_with_unsigned(0)
        return value
    }

    /// Any JSON number, to the nearest float64.
    pub mutating fun read_float64(): float64 {
        val text = self.number_text()
        if self.failed { return 0.0 }
        return unsafe { kf_json_parse_float64(text.as_str()) }
    }

    pub mutating fun read_bool(): bool {
        self.skip_space()
        if self.consume_word("true") { return true }
        if self.consume_word("false") { return false }
        self.fail()
        return false
    }

    pub mutating fun read_null(): bool {
        self.skip_space()
        if self.consume_word("null") { return true }
        self.fail()
        return false
    }

    /// True when the next value is `null`, which is then consumed; otherwise
    /// nothing is.
    pub mutating fun take_null(): bool {
        self.skip_space()
        return self.consume_word("null")
    }

    /// Consumes the next value whatever it is, nested containers included, so
    /// a caller can pass over fields it does not know.
    pub mutating fun skip_value(): void {
        when self.peek_kind() {
            String => { val _text = self.read_string() }
            Object => {
                self.position = self.position + 1
                while self.object_has_next() {
                    val _key = self.read_key()
                    self.skip_value()
                }
            }
            Array => {
                self.position = self.position + 1
                while self.array_has_next() { self.skip_value() }
            }
            Bool => { val _flag = self.read_bool() }
            Null => { val _null = self.read_null() }
            Number => { val _number = self.number_text() }
            End => self.fail()
            Invalid => self.fail()
        }
    }

    /// The next number's text, checked against JSON's grammar:
    /// `-? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?`.
    mutating fun number_text(): String {
        self.skip_space()
        val start = self.position
        if self.peek() == 45 { self.position = self.position + 1 }
        if self.peek() == 48 {
            self.position = self.position + 1
        } else if !self.digits() {
            self.fail()
            return ""
        }
        if self.peek() == 46 {
            self.position = self.position + 1
            if !self.digits() {
                self.fail()
                return ""
            }
        }
        if self.peek() == 101 || self.peek() == 69 {
            self.position = self.position + 1
            if self.peek() == 43 || self.peek() == 45 { self.position = self.position + 1 }
            if !self.digits() {
                self.fail()
                return ""
            }
        }
        return self.source.substring(start, self.position)
    }

    /// Consumes a run of digits; false when there is none.
    mutating fun digits(): bool {
        val start = self.position
        while self.peek() >= 48 && self.peek() <= 57 { self.position = self.position + 1 }
        return self.position > start
    }

    mutating fun container_has_next(end_byte: uint8): bool {
        if self.failed { return false }
        self.skip_space()
        if self.peek() == end_byte {
            self.position = self.position + 1
            return false
        }
        if self.after_opening() { return true }
        if self.peek() != 44 {
            self.fail()
            return false
        }
        self.position = self.position + 1
        self.skip_space()
        if self.peek() == end_byte {
            self.fail()
            return false
        }
        return true
    }

    /// Nothing but whitespace since the `[` or `{`: the first element needs no
    /// comma before it, and every later one does.
    fun after_opening(): bool {
        var i = self.position
        while i > 0 {
            i = i - 1
            val byte = self.source.byte(i)
            if byte != 32 && byte != 9 && byte != 10 && byte != 13 { return byte == 91 || byte == 123 }
        }
        return false
    }

    mutating fun consume_byte(expected: uint8): bool {
        self.skip_space()
        if self.peek() != expected {
            self.fail()
            return false
        }
        self.position = self.position + 1
        return true
    }

    mutating fun consume_word(word: str): bool {
        val n = word.byte_len()
        if self.position + n > self.source.byte_len() { return false }
        val zero: uint64 = 0
        while i in zero..n {
            if self.source.byte(self.position + i) != word.byte(i) { return false }
        }
        self.position = self.position + n
        return true
    }

    mutating fun skip_space(): void {
        while self.position < self.source.byte_len() {
            val byte = self.peek()
            if byte != 32 && byte != 9 && byte != 10 && byte != 13 { return }
            self.position = self.position + 1
        }
    }

    /// 0 past the end, which no JSON value starts with.
    fun peek(): uint8 {
        if self.position >= self.source.byte_len() { return 0 }
        return self.source.byte(self.position)
    }

    mutating fun fail(): void {
        if self.failed { return }
        self.failed = true
        self.failed_at = self.position
    }

    mutating fun failed_with(value: int64): int64 {
        self.fail()
        return value
    }

    mutating fun failed_with_unsigned(value: uint64): uint64 {
        self.fail()
        return value
    }

    fun append_slice(out: &var String, start: uint64, end: uint64): void {
        if end > start {
            val piece = self.source.substring(start, end)
            out.append(piece.as_str())
        }
    }

    mutating fun append_escape(out: &var String): void {
        val byte = self.peek()
        self.position = self.position + 1
        when byte {
            34  => out.push_byte(34)
            92  => out.push_byte(92)
            47  => out.push_byte(47)
            98  => out.push_byte(8)
            102 => out.push_byte(12)
            110 => out.push_byte(10)
            114 => out.push_byte(13)
            116 => out.push_byte(9)
            117 => self.append_unicode(out)
            _   => self.fail()
        }
    }

    /// `\uXXXX`, or a surrogate pair `\uD8XX\uDCXX`, as UTF-8.
    mutating fun append_unicode(out: &var String): void {
        val first = self.hex4()
        if first > 65535 || (first >= 56320 && first <= 57343) {
            self.fail()
            return
        }
        if first < 55296 || first > 56319 {
            out.push_utf8(first)
            return
        }
        if !self.consume_word("\\u") {
            self.fail()
            return
        }
        val second = self.hex4()
        if second < 56320 || second > 57343 {
            self.fail()
            return
        }
        out.push_utf8(65536 + (first - 55296) * 1024 + (second - 56320))
    }

    /// Four hex digits as a number, consumed; 65536 when they are not.
    mutating fun hex4(): uint32 {
        if self.position + 4 > self.source.byte_len() { return 65536 }
        var value: uint32 = 0
        val zero: uint64 = 0
        while i in zero..4 {
            val digit = hex_value(self.source.byte(self.position + i))
            if digit > 15 { return 65536 }
            value = value * 16 + (digit as uint32)
        }
        self.position = self.position + 4
        return value
    }
}

/// The digits of `text` from `from` as a number no greater than `limit`, or
/// None when it is greater or holds anything but digits.
fun integer_value(text: str, from: uint64, limit: uint64): uint64? {
    var value: uint64 = 0
    var i = from
    while i < text.byte_len() {
        val byte = text.byte_at(i)
        if byte < 48 || byte > 57 { return null }
        val digit = (byte - 48) as uint64
        if value > (limit - digit) / 10 { return null }
        value = value * 10 + digit
        i = i + 1
    }
    return value
}

fun hex_value(byte: uint8): uint8 {
    if byte >= 48 && byte <= 57 { return byte - 48 }
    if byte >= 65 && byte <= 70 { return byte - 55 }
    if byte >= 97 && byte <= 102 { return byte - 87 }
    return 255
}

/// One Unicode scalar value, encoded.
mutating fun String.push_utf8(code: uint32): void {
    if code < 128 {
        self.push_byte(code as uint8)
    } else if code < 2048 {
        self.push_byte((192 + code / 64) as uint8)
        self.push_byte((128 + code % 64) as uint8)
    } else if code < 65536 {
        self.push_byte((224 + code / 4096) as uint8)
        self.push_byte((128 + code / 64 % 64) as uint8)
        self.push_byte((128 + code % 64) as uint8)
    } else {
        self.push_byte((240 + code / 262144) as uint8)
        self.push_byte((128 + code / 4096 % 64) as uint8)
        self.push_byte((128 + code / 64 % 64) as uint8)
        self.push_byte((128 + code % 64) as uint8)
    }
}
